@model  List<ProjectCuisine.Application.DTOs.Country.CountryListDto>
@{
    ViewData["Title"] = "Countries";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-dark">Countries Management</h2>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            &larr; Back to Dashboard
        </a>
    </div>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm" role="alert">
            <h5 class="mb-0">No countries available!</h5>
            <p class="mb-0 text-muted">Try adding some countries to your database.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Country Name</th>
                                <th scope="col">Flag</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var country in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@country.Name</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(country.FlagUrl))
                                        {
                                            <img src="@country.FlagUrl" alt="@country.Name"
                                                 class="img-thumbnail rounded"
                                                 style="height: 80px; width: 120px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No Flag</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
}
</div>
