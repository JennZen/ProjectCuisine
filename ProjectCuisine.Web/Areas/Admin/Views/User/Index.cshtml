@model List<ProjectCuisine.Web.Models.Admin.UserViewModel>
@{
	ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="mb-0 text-dark">User Management</h2>
		<a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
			&larr; Back to Dashboard
		</a>
	</div>
	@if (Model == null || !Model.Any())
	{
		<div class="alert alert-info text-center shadow-sm" role="alert">
			<h5 class="mb-0">No users available!</h5>
			<p class="mb-0 text-muted">Try adding some users to your database.</p>
		</div>
	}
	else
	{
		<div class="card shadow-sm border-0">
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0">
						<thead class="table-light">
							<tr>
								<th scope="col" class="ps-4">Id</th>
								<th scope="col">Email</th>
								<th scope="col">Role</th>
								<th scope="col">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var user in Model)
							{
								<tr>
									<td class="ps-4 fw-bold">@user.Id</td>
									<td>@user.Email</td>
									<td>@user.Role</td>
									<td>
										<a asp-area="Admin" asp-controller="User" asp-action="ChangeRole" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
											Edit
										</a>
										<a asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
											Delete
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
}
</div>
