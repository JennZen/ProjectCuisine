@model List<ProjectCuisine.Application.DTOs.Recipe.RecipeDetailsDto>

@{
    ViewData["Title"] = "Recipes";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-dark">Recipes Management</h2>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            &larr; Back to Dashboard
        </a>
    </div>

    <form asp-action="Create" method="post" class="d-inline">
        <button type="submit" class="btn btn-sm btn-outline-primary mb-4">
            Create new recipe
        </button>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm" role="alert">
            <h5 class="mb-0">No recipes available!</h5>
            <p class="mb-0 text-muted">Try adding some recipes to your database.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Id</th>
                                <th scope="col">Name</th>
                                <th scope="col">Description</th>
                                <th scope="col">Instructions</th>
                                <th scope="col">Image</th>
                                <th scope="col">Category</th>
                                <th scope="col">Country</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var recipe in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@recipe.Id</td>
                                    <td>@recipe.Name</td>
									<td>@recipe.Description</td>
									<td>@recipe.Instructions</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                                        {
                                            <img src="@recipe.ImageUrl" alt="@recipe.Name"
                                                 class="img-thumbnail rounded"
                                                 style="height: 80px; width: 80px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No Image</span>
                                        }
                                    </td>
									<td>@recipe.CategoryName</td>
									<td>@recipe.CountryName</td>
                                    <td>
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@recipe.Id" />

                                            <button type="submit" class="btn btn-sm btn-outline-danger mb-4">
                                                Delete
                                            </button>
                                        </form>
                                        <form asp-action="Update" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@recipe.Id" />

                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                Update
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>