@model ProjectCuisine.Application.DTOs.Recipe.RecipeCreateDto
@{
	ViewData["Title"] = "Create Recipe";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-6 col-lg-5">
			<div class="card shadow-sm border-0 rounded-3">
				<div class="card-body p-4 p-sm-5">

					<form asp-controller="Recipe" asp-action="Create" method="post">

						<div asp-validation-summary="All" class="text-danger mb-3"></div>

						<div class="mb-3">
							<label asp-for="Name" class="form-label"></label>
							<input asp-for="Name" class="form-control" />
							<span asp-validation-for="Name" class="text-danger small"></span>
						</div>

						<div class="mb-3">
							<label asp-for="Description" class="form-label"></label>
							<input asp-for="Description" class="form-control" />
							<span asp-validation-for="Description" class="text-danger small"></span>
						</div>

						<div class="mb-3">
							<label asp-for="Instructions" class="form-label"></label>
							<input asp-for="Instructions" class="form-control" />
							<span asp-validation-for="Instructions" class="text-danger small"></span>
						</div>

						<div class="mb-3">
							<label asp-for="ImageUrl" class="form-label"></label>
							<input asp-for="ImageUrl" class="form-control" />
							<span asp-validation-for="ImageUrl" class="text-danger small"></span>
						</div>

						<div class="mb-3">
							<label asp-for="CategoryId" class="form-label"></label>
							<input asp-for="CategoryId" class="form-control" />
							<span asp-validation-for="CategoryId" class="text-danger small"></span>
						</div>

						<div class="mb-4">
							<label asp-for="CountryId" class="form-label"></label>
							<input asp-for="CountryId" class="form-control" />
							<span asp-validation-for="CountryId" class="text-danger small"></span>
						</div>

						<button type="submit" class="btn btn-primary w-100 py-2">Create Recipe</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>