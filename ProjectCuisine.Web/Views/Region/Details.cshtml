@model (ProjectCuisine.Application.DTOs.Region.RegionPageDto Region, List<ProjectCuisine.Application.DTOs.Country.CountryListDto> Countries)

@{
    ViewData["Title"] = $"Details for {Model.Region.Name}";
}

<h1>Explore countries of @Model.Region.Name</h1>

<h2>Countries</h2>
<div class="row">
    @foreach(var country in Model.Countries)
    {
        <div class="card" style="width:200px; height:170px">
            <div class="card-body">
                <h4 class="card-title">@country.Name</h4>
                <a href="#"></a>
            </div>
            <img class="card-img-bottom rounded" src="@country.FlagUrl" alt="@country.Name" style="width:100%; height:95px; object-fit:cover;">
        </div>
    }
</div>

