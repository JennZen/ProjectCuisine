@model List<ProjectCuisine.Application.DTOs.Region.RegionListDto>

@{
    ViewData["Title"] = "Regions";
}

<style>
    .region-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

     .region-card:hover {
         transform: translateY(-5px);
         box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
     }
</style>

<div class="p-4 mb-4 bg-primary text-white text-center rounded-3 shadow-sm">
    <h1 class="fw-bold m-0">Explore every region!</h1>
</div>

<div class="row g-4">
    @foreach (var region in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm region-card overflow-hidden">
                <a asp-controller="Country" asp-action="Index" asp-route-id="@region.Id">
                    <img class="card-img-top"
                         src="@region.ImageUrl"
                         alt="@region.Name"
                         style="height: 220px; object-fit: cover;">
                </a>

                <div class="card-body d-flex flex-column justify-content-between p-3">
                    <h4 class="card-title fw-bold text-dark mb-3">@region.Name</h4>

                    <a asp-controller="Country"
                       asp-action="Index"
                       asp-route-id="@region.Id"
                       class="btn btn-primary w-100 fw-semibold">
                        Details
                    </a>
                </div>
            </div>
        </div>
    }
</div>