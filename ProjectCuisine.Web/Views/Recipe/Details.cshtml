@model ProjectCuisine.Application.DTOs.Recipe.RecipeDetailsDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <nav class="mb-4" aria-label="breadcrumb">
        <a asp-controller="Recipe" asp-action="Index" asp-route-id="@Model.CountryId" class="btn btn-outline-secondary rounded-pill shadow-sm">
            ← Back to Recipes
        </a>
    </nav>

    <div class="bg-primary text-white text-center p-1 p-md-2 rounded-4 shadow mb-4">
        <h1 class="display-3 fw-extrabold mb-3">@Model.Name</h1>
        <p class="fs-4 text-white-50 max-width-600 mx-auto mb-0" style="color: rgba(255, 255, 255, 0.75) !important;">
            @Model.Description
        </p>
    </div>

    <div class="text-center mb-5">
        <img src="@Model.ImageUrl"
             alt="@Model.Name"
             class="img-fluid rounded-4 shadow-lg border border-4 border-white"
             style="max-height: 450px; width: 100%; object-fit: cover; max-width: 800px;" />
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-3 p-md-4">
                    <h3 class="m-0 fw-bold d-flex align-items-center justify-content-center gap-2">
                       Instructions
                    </h3>
                </div>
                <div class="card-body p-4 p-md-5 bg-light">
                    <div class="bg-white p-4 rounded-3 shadow-sm text-secondary lh-lg fs-5 style-instructions">
                        @Model.Instructions
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>