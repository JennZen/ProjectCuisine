@model List<ProjectCuisine.Application.DTOs.Recipe.RecipeListDto>
@{
	ViewData["Title"] = $"{ViewBag.CountryName} Recipes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
	.recipe-card-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.recipe-card {
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

		.recipe-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
		}

	.filter-select {
		cursor: pointer;
		border-radius: 0 50rem 50rem 0 !important;
	}

	.filter-icon-addon {
		border-radius: 50rem 0 0 50rem !important;
	}
</style>

<div class="p-4 mb-4 bg-primary text-white text-center rounded-3 shadow-sm">
	<h1 class="fw-bold m-0">Explore recipes of @ViewBag.CountryName</h1>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

	<nav aria-label="breadcrumb">
		<a asp-controller="Country" asp-action="Index" asp-route-id="@ViewBag.RegionId" class="btn btn-outline-secondary rounded-pill d-inline-flex align-items-center gap-2">
			<i class="bi bi-arrow-left"></i>
			<span class="fw-semibold">Back to Countries</span>
		</a>
	</nav>

	<form method="get" asp-controller="Recipe" asp-action="Index" class="d-flex align-items-center">
		<input type="hidden" name="id" value="@ViewBag.CountryId" />

		<div class="input-group input-group-sm shadow-sm" style="min-width: 240px;">
			<span class="input-group-text bg-white border-end-0 filter-icon-addon text-primary">
				<i class="bi bi-funnel-fill"></i>
			</span>
			<select name="categoryId"
					id="categoryId"
					asp-items="ViewBag.Categories"
					class="form-select form-select-sm border-start-0 filter-select fw-semibold text-secondary"
					onchange="this.form.submit()">
				<option value="">All Categories</option>
			</select>
		</div>
	</form>

</div>

@if (!Model.Any())
{
	<div class="alert alert-info text-center p-4 rounded-3 shadow-sm my-4">
		<h4 class="alert-heading fw-bold mb-2">No recipes found</h4>
		<p class="m-0">No recipes found for this selection.</p>
	</div>
}
else
{
	<div class="row g-3">
		@foreach (var recipe in Model)
		{
			<div class="col-12 col-sm-6 col-md-4 col-lg-3">
				<div class="card h-100 border-0 shadow-sm recipe-card overflow-hidden position-relative">

					<form asp-controller="FavoriteRecipe"
						  asp-action="Toggle"
						  asp-route-id="@recipe.Id"
						  method="post"
						  class="position-absolute top-0 end-0 m-2"
						  style="z-index: 10;">

						<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
						<button type="submit"
								class="btn btn-light btn-sm rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0"
								style="width: 36px; height: 36px;">
							<i class="bi bi-heart-fill text-danger fs-5"></i>
						</button>
					</form>

					<a asp-controller="Recipe"
					   asp-action="Details"
					   asp-route-id="@recipe.Id"
					   class="recipe-card-link h-100">

						<img class="card-img-top"
							 src="@recipe.ImageUrl"
							 alt="@recipe.Name"
							 style="height: 200px; object-fit: cover;">

						<div class="card-body p-3 text-center d-flex align-items-center justify-content-center">
							<h6 class="card-title fw-bold m-0 text-truncate">@recipe.Name</h6>
						</div>
					</a>
				</div>
			</div>
		}
	</div>
}