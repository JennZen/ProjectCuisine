@model List<ProjectCuisine.Application.DTOs.Country.CountryListDto>

@{
    ViewData["Title"] = $"Details for {ViewBag.Region.Name}";
}

<style>
    .country-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .country-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .country-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
        }
</style>

<div class="p-4 mb-4 bg-primary text-white text-center rounded-3 shadow-sm">
    <h1 class="fw-bold m-0">Explore countries of @ViewBag.Region.Name</h1>
</div>

<nav class="mb-3" aria-label="breadcrumb">
    <a asp-controller="Region" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
        <h5>← Back to Regions</h5>
    </a>
</nav>

@if (!Model.Any())
{
    <div class="alert alert-info text-center p-4 rounded-3 shadow-sm my-4">
        <h4 class="alert-heading fw-bold mb-2">No countries found</h4>
        <p class="m-0">There are no countries added to this region yet.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var country in Model)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <a asp-controller="Recipe"
                   asp-action="Index"
                   asp-route-id="@country.Id"
                   class="country-card-link h-100">

                    <div class="card h-100 border-0 shadow-sm country-card overflow-hidden">
                        <img class="card-img-top"
                             src="@country.FlagUrl"
                             alt="@country.Name"
                             style="height: 110px; object-fit: cover;">

                        <div class="card-body p-2 text-center d-flex align-items-center justify-content-center">
                            <h6 class="card-title fw-bold m-0 text-truncate">@country.Name</h6>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}