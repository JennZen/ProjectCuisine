@model List<ProjectCuisine.Application.DTOs.Recipe.RecipeListDto>
@{
	ViewData["Title"] = $"{ViewBag.CountryName} Details";
}

<h1 class="container-fluid p-1 my-1 bg-gradient text-black text-center">
	Explore recipes of @ViewBag.CountryName
</h1>

<nav class="mb-3" aria-label="breadcrumb">
	<a asp-controller="Region" asp-action="Details" asp-route-id="@ViewBag.RegionId" class="btn btn-sm btn-outline-secondary rounded-pill">
		<h5>← Back to Countries</h5>
	</a>
</nav>

@if (!Model.Any())
{
	<h2 class="text-danger">No recipes found for this country.</h2>
}

<div class="row">
	@foreach(var recipe in Model)
	{
		<a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id">
			<div class="card" style="width:400px; height:425px;">
				<div class="card-body">
					<h4 class="card-title">@recipe.Name</h4>
				</div>
				<img class="card-img-bottom; rounded" src="@recipe.ImageUrl" alt="@recipe.Name" style="width:100%; height:300px; object-fit:cover;">
			</div>
		</a>	
	}
</div>